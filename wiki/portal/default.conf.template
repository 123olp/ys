server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /runtime-config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 'window.HUMAN_INFRA_PORTAL={wikiPort:"${WIKI_PUBLIC_PORT}"};';
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~ \.template$ {
        return 404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
