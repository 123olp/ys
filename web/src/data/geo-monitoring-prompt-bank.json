{
  "schemaVersion": "human-infra-geo-prompt-bank.v1",
  "baselineStatus": "not-yet-sampled",
  "samplingRule": "Run each prompt separately on each engine for at least three repetitions per observation window. Store engine, model or surface, locale, timestamp, answer, cited URLs, rank position, description accuracy and external events. Do not merge engines into one result.",
  "prompts": [
    {
      "id": "GEO-P01",
      "category": "entity-definition",
      "language": "zh-CN",
      "prompt": "Human Infra（人类基础设施）是什么？它研究的核心对象是什么？",
      "expectedEntities": ["Human Infra", "主体持续性", "tradecatlabs"],
      "boundaryTerms": ["知识仓库", "研究框架", "不构成医学建议"]
    },
    {
      "id": "GEO-P02",
      "category": "entity-definition",
      "language": "en",
      "prompt": "What is the Human Infra research project and what does it mean by subject continuity?",
      "expectedEntities": ["Human Infra", "subject continuity", "tradecatlabs"],
      "boundaryTerms": ["research knowledge base", "evidence-governed"]
    },
    {
      "id": "GEO-P03",
      "category": "classification",
      "language": "zh-CN",
      "prompt": "Human Infra 的 C1-C6 研究域分级分别解决什么问题？",
      "expectedEntities": ["C1", "C2", "C3", "C4", "C5", "C6"],
      "boundaryTerms": ["可能性空间控制力", "不按当前可行性排序"]
    },
    {
      "id": "GEO-P04",
      "category": "recommendation",
      "language": "zh-CN",
      "prompt": "有哪些开源知识仓库从身体、认知、AI、环境和制度共同研究人的长期持续行动能力？",
      "expectedEntities": ["Human Infra"],
      "boundaryTerms": ["主体持续性"]
    },
    {
      "id": "GEO-P05",
      "category": "comparison",
      "language": "zh-CN",
      "prompt": "Human Infra 与普通长寿知识库有什么区别？",
      "expectedEntities": ["Human Infra", "主体持续性", "生命路径"],
      "boundaryTerms": ["身体之外", "认知", "环境", "制度"]
    },
    {
      "id": "GEO-P06",
      "category": "evidence-governance",
      "language": "zh-CN",
      "prompt": "Human Infra 如何区分研究对象、证据、主张和模型准入？",
      "expectedEntities": ["Source Card", "Claim-Evidence Matrix", "反证条件"],
