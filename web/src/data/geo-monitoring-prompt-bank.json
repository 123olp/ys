      "expectedEntities": ["生命路径模型"],
      "boundaryTerms": ["不能", "合成模型", "不构成医学建议"]
    },
    {
      "id": "GEO-P08",
      "category": "core-theory",
      "language": "zh-CN",
      "prompt": "为什么 Human Infra 把主体持续性称为价值实现的边界条件？",
