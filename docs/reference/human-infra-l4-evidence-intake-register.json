    "hashAlgorithms": [
      "sha256"
    ],
    "acceptanceRules": [
      "packet.workOrderId must match an existing evidenceSlotGroups[].workOrderId",
      "packet.slotId must match a slot inside the matching work order",
      "packet.candidatePath must match the matching work order candidatePath",
      "packet.evidenceClass must match the matching slot evidenceClass",
      "packet.repositoryPolicy must match the matching slot repositoryPolicy",
      "packet.artifactHash must be a sha256 hash of a redacted artifact or redacted external-evidence summary",
      "packet.evidenceStatus must be human-reviewed-redacted or second-reviewed-redacted before the slot can close",
      "packet.firstReviewerRole must not be ai-only",
      "packet.rawDataTracked, restrictedDataTracked, identifierTracked, publicAiUpload and aiOnlySignoff must all be false",
      "packet.allowedUse must remain bounded L4 evidence review only",
      "packet.downstreamDecision must remain l4-still-blocked until every required slot closes and model-admission gates pass"
    ],
    "prohibitedPacketUses": [
      "public-weighted-domain-output",
      "calibrated-prediction",
      "individual-prediction",
      "individual-death-date-output",
      "medical-advice",
      "intervention-ranking",
      "raw-row-reconstruction"
    ],
