{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-infra.local/docs/reference/history-timeline/works-subset.schema.json",
  "title": "Human Infra History Timeline Works Subset",
  "description": "永生史第一版作品子集的机器契约，只登记入选事件，不代替复核状态。",
  "type": "object",
  "required": [
    "subset_id",
    "version",
    "title",
    "created_at",
    "description",
    "selection_criteria",
    "reviewed_event_count",
    "fresh_reviewed_event_count",
    "event_ids",
    "stats"
  ],
  "additionalProperties": false,
  "properties": {
    "subset_id": {
      "type": "string",
      "pattern": "^HITL-WS-V[0-9]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "selection_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_event_count": {
      "type": "integer",
      "minimum": 0
    },
    "fresh_reviewed_event_count": {
      "type": "integer",
      "minimum": 0
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^HIT-[A-Z]{3}-[0-9]{3,}$"
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "total_selected",
        "pre_modern_selected",
        "modern_selected"
      ],
      "properties": {
        "total_selected": {
          "type": "integer"
        },
        "pre_modern_selected": {
          "type": "integer"
        },
        "modern_selected": {
          "type": "integer"
        },
        "by_period": {
          "type": "object"
        },
        "by_path_family": {
          "type": "object"
        },
        "by_event_type": {
          "type": "object"
        },
        "by_evidence_grade": {
          "type": "object"
        },
        "by_significance": {
          "type": "object"
        }
      }
    }
  }
}
