      "title": "永生史交互时间轴",
      "kind": "interactive_timeline",
      "status": "working_draft",
      "review_gate": "locally_reviewed",
      "display_mode": "echarts_chart",
      "subset_id": "HITL-WS-V1",
      "source_html": "docs/reference/history-timeline/preview.html"
    },
    {
      "publication_id": "pub-history-narrative",
      "title": "永生史：人类追求永生的全部历程",
      "kind": "narrative",
      "status": "working_draft",
      "review_gate": "fresh_reviewed",
      "display_mode": "markdown_article",
      "subset_id": "HITL-WS-V1",
      "source_md": "docs/publications/history-of-immortality.md"
    },
    {
