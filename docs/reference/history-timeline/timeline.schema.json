{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-infra.local/docs/reference/history-timeline/timeline.schema.json",
  "title": "Human Infra History Timeline",
  "description": "Human Infra 永生史严肃历史年表的机器契约。",
  "type": "object",
  "required": [
    "timeline_id",
    "title",
    "version",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "timeline_id": {
      "type": "string",
      "pattern": "^HITL-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "source_type",
        "label",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^SRC-[0-9]{3,}$"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "tertiary",
            "expert_narrative"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": "string"
        },
        "access_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "source_ref": {
      "type": "string",
      "pattern": "^SRC-[0-9]{3,}$"
    },
    "period_ref": {
      "type": "string",
      "pattern": "^period-[a-z0-9-]+$"
    },
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "title",
        "date_start",
        "date_type",
        "civilization",
        "region",
        "path_family",
        "event_type",
        "claim",
        "summary",
        "sources",
        "evidence_grade",
        "verification_status",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^HIT-[A-Z]{3}-[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "date_start": {
          "type": "string",
          "minLength": 1
        },
        "date_end": {
          "type": "string",
          "minLength": 1
        },
        "date_type": {
          "type": "string",
          "enum": [
            "exact",
            "approx",
            "range",
            "long_process",
            "era",
            "undated"
          ]
        },
        "period_id": {
          "$ref": "#/$defs/period_ref"
        },
        "civilization": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "path_family": {
          "type": "string",
          "enum": [
            "maintenance",
            "reconstruction",
            "suspension",
            "digital_migration",
            "cognitive_extension",
            "social_composite",
            "philosophical",
            "cross_path"
          ]
        },
        "event_type": {
          "type": "string",
          "enum": [
            "myth",
            "religious",
            "thought",
            "practice",
            "technology",
            "institution",
            "literature",
            "failure",
            "demographic",
            "policy"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "evidence_grade": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "I",
            "T",
            "L"
          ]
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "unreviewed",
            "locally_reviewed",
            "fresh_reviewed",
            "blocked",
            "superseded"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "needs_revision",
            "published",
            "archived"
          ]
        },
        "significance": {
          "type": "string",
          "enum": [
            "minor",
            "medium",
            "major",
            "turning_point"
          ]
        },
        "uncertainty": {
          "type": "string"
        },
        "cross_links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chapter": {
          "type": "string"
        },
        "last_reviewed": {
          "type": "string",
          "format": "date"
        },
        "reviewer": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
