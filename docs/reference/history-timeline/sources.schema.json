{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-infra.local/docs/reference/history-timeline/sources.schema.json",
  "title": "Human Infra History Timeline Source Registry",
  "description": "Human Infra 永生史年表的来源卡机器契约。",
  "type": "object",
  "required": [
    "timeline_id",
    "version",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "timeline_id": {
      "type": "string",
      "pattern": "^HITL-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "source_type",
        "label",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^SRC-[0-9]{3,}$"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "tertiary",
            "expert_narrative"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": "string"
        },
        "access_date": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
