{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-infra.local/docs/reference/history-timeline/works-review-register.schema.json",
  "title": "Human Infra History Timeline Works Review Register",
  "description": "永生史作品子集的本地复核登记，只记录本地复核结论，不代替独立 fresh review。",
  "type": "object",
  "required": [
    "register_id",
    "version",
    "created_at",
    "reviewer",
    "review_method",
    "limitations",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "register_id": {
      "type": "string",
      "pattern": "^HITL-WSR-V[0-9]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "string"
    },
    "review_method": {
      "type": "string"
    },
    "limitations": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "verdict",
          "reviewed_at",
          "source_status",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^HIT-[A-Z]{3}-[0-9]{3,}$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "locally_reviewed",
              "needs_revision",
              "blocked"
            ]
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_status": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "integer"
              ]
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
